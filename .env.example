# Tshienda Sneaker Care Environment Configuration
# Copy this file to .env for local development or set in cloud environment

FLASK_APP=run.py
FLASK_ENV=development
FLASK_CONFIG=development
SECRET_KEY=tshienda-dev-secret-key-uwc-2026-secure-random

# Database Configuration (defaults to SQLite; set PostgreSQL URL in production)
# Example PostgreSQL: postgresql://tshienda_user:password@localhost:5432/tshienda_db
DATABASE_URL=sqlite:///instance/tshienda.db

# Security & Lockout Policy
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_TRACK_PER_MINUTE=15

# POPIA Compliance Retention (months to retain customer phone numbers after collection)
POPIA_PHONE_RETENTION_MONTHS=12

# Campus Kiosk Configuration
CAMPUS_NAME=University of the Western Cape (UWC)
LOCATION_NOTE=Student Centre Kiosk, Robert Sobukwe Rd, Bellville, Cape Town
OFFICIAL_CONTACT_PHONE=+27820000000

# WhatsApp Integration
# Phase 1 uses one-tap wa.me links generated on-the-fly (always active).
# Phase 2 (Meta WhatsApp Business Cloud API) is disabled by default:
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-waba-id
